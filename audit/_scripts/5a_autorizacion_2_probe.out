========================================================================
A) IDOR — el ATACANTE apunta a los ids de la VICTIMA
========================================================================
  PUT    /api/plazos-fijos/{pid}             -> 404  {"detail":"Plazo fijo no encontrado"}
  DELETE /api/plazos-fijos/{pid}             -> 200  {"ok":true}
  POST   /api/plazos-fijos/{pid}/renovar     -> 404  {"detail":"Plazo fijo no encontrado"}
  POST   /api/plazos-fijos/{pid}/cobrar      -> 404  {"detail":"Plazo fijo no encontrado"}
  PUT    /api/monthly/{eid}                  -> 404  {"detail":"Not found"}
  DELETE /api/monthly/{eid}                  -> 200  {"ok":true}
  PUT    /api/operations/{oid}               -> 404  {"detail":"Not found"}
  DELETE /api/operations/{oid}               -> 404  {"detail":"Operación no encontrada"}
  PUT    /api/futures/{fid}                  -> 404  {"detail":"Posición de futuros no encontrada (o ya cerrada)"}
  DELETE /api/futures/{fid}                  -> 404  {"detail":"Posición de futuros no encontrada"}
  POST   /api/futures/{fid}/close            -> 404  {"detail":"Posición de futuros no encontrada"}
  POST   /api/brokers/{bid}/usd-sibling      -> 404  {"detail":"Broker no encontrado"}

