# ⚠️ NO ES LA APP. Imagen del servicio TEMPORAL `suite-supabase` de Railway, que corre la
# suite de pruebas contra el Supabase nuevo desde US West (ver
# audit/SUITE_SUPABASE_DESDE_RAILWAY.md).
#
# Por qué un Dockerfile y no `railway.suite.toml`: el 31/10/2026 Railway ignoró ese
# archivo de configuración, armó la imagen con Railpack, detectó `start.sh` (el
# arranque local) y lo repitió en bucle sin Python («pip3: command not found»).
# Con `RAILWAY_DOCKERFILE_PATH=Dockerfile.suite` en las variables del servicio, la
# imagen sale de acá y no depende de qué detecte Railway.
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt \
 && pip install --no-cache-dir 'pytest==8.4.2' 'pytest-timeout==2.4.0'

COPY . .

CMD ["bash", "scripts/suite_contra_supabase.sh"]
