{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://trading-production-143b.up.railway.app/api/$1" },
    { "source": "/planes", "destination": "/planes/index.html" },
    { "source": "/terminos", "destination": "/terminos/index.html" },
    { "source": "/reembolso", "destination": "/reembolso/index.html" },
    { "source": "/privacidad", "destination": "/privacidad/index.html" },
    { "source": "/brokers/cocos", "destination": "/brokers/cocos/index.html" },
    { "source": "/brokers/iol", "destination": "/brokers/iol/index.html" },
    { "source": "/brokers/binance", "destination": "/brokers/binance/index.html" },
    { "source": "/cedears", "destination": "/cedears/index.html" },
    { "source": "/bonos-argentinos", "destination": "/bonos-argentinos/index.html" },
    { "source": "/afip-cripto", "destination": "/afip-cripto/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/fifo-cedears-argentina", "destination": "/blog/fifo-cedears-argentina/index.html" },
    { "source": "/blog/pnl-real-usd-blue-argentina", "destination": "/blog/pnl-real-usd-blue-argentina/index.html" },
    { "source": "/blog/comparativa-brokers-argentina", "destination": "/blog/comparativa-brokers-argentina/index.html" },
    { "source": "/guia", "destination": "/guia/index.html" },
    { "source": "/guia/empezar", "destination": "/guia/empezar/index.html" },
    { "source": "/guia/cartera-y-operaciones", "destination": "/guia/cartera-y-operaciones/index.html" },
    { "source": "/guia/insights-y-reportes", "destination": "/guia/insights-y-reportes/index.html" },
    { "source": "/guia/coach-ia", "destination": "/guia/coach-ia/index.html" },
    { "source": "/guia/novedades", "destination": "/guia/novedades/index.html" },
    { "source": "/guia/cuenta-y-planes", "destination": "/guia/cuenta-y-planes/index.html" },
    { "source": "/guia/asesores", "destination": "/guia/asesores/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com; connect-src 'self' https://trading-production-143b.up.railway.app https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(planes|terminos|reembolso|privacidad|brokers/.*|cedears|bonos-argentinos|afip-cripto|blog|blog/.*|guia|guia/.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
